# Copy this file to .env.local for local development, or add each value as a
# Cloudflare Worker secret for production (see SETUP.md). Placeholders only.

# Cloudflare R2 (S3-compatible API) - server-side only
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-private-bucket-name

# Resend - server-side only
RESEND_API_KEY=re_your_resend_api_key
QUOTE_NOTIFICATION_EMAIL=tim@accu-script.com
QUOTE_FROM_EMAIL=tim@accu-script.com

# Public URL of the deployed site (no trailing slash)
APP_BASE_URL=https://your-domain.example

# Long random string (32+ chars) used to sign upload tokens
# Generate one with: openssl rand -base64 48
UPLOAD_TOKEN_SECRET=replace-with-a-long-random-string
